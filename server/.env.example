# River of Life Bible Application — Production Environment Configuration

# 1. Server & Environment Settings
PORT=7880
NODE_ENV=production
CORS_ORIGIN=*

# 2. Database Settings (PostgreSQL Production / SQLite Local Dev)
USE_POSTGRES=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/river_of_life
DB_POOL_MAX=20

# 3. JWT & Session Security Secrets
JWT_SECRET=river_of_life_jwt_production_secret_key_2026_super_secure

# 4. SMS Provider Settings (dev / twilio / msg91)
SMS_PROVIDER=dev
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+18005550199
MSG91_AUTH_KEY=xxxxxxxxxxxxxxxx
MSG91_TEMPLATE_ID=65xxxxxxxxxxxxxx

# 5. LiveKit WebRTC Real-Time Video/Audio Credentials
LIVEKIT_URL=wss://river-of-life.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 6. Push Notification Credentials (FCM / APNs)
FCM_SERVER_KEY=AAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX

# 7. AI Bible Assistant Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
